<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aero_fondo"> <!-- Fondo degradado Frutiger Aero -->

    <!-- Panel de Cristal que contiene el formulario centrado -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_aero_cristal"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Título con estilo Frutiger Aero -->
        <TextView
            android:id="@+id/txtTituloFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Nuevo Registro de Luz"
            android:textColor="#01579B"
            android:shadowColor="#FFFFFF"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Ubicación (ej. Puerta principal)"
            android:inputType="text"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtNivelLuz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Nivel de Luz (ej. 250)"
            android:inputType="number"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Estado (ej. Vigilando)"
            android:inputType="text"
            android:minHeight="48dp" />

        <!-- Botón Guardar brillante y redondeado -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_aero_boton_azul"
            android:minHeight="48dp"
            android:onClick="onGuardarLecturaClick"
            android:text="Guardar Registro"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:elevation="4dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Botón Volver con el color azul del tema -->
        <Button
            android:id="@+id/btnVolverForm"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Volver"
            android:textColor="#01579B"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>